# CodinX — salin file ini menjadi `.env` di folder CodinX/proyek lalu isi API key kamu:
# File `.env` jangan pernah di-upload ke GitHub.
#     cp .env.example .env && chmod 600 .env
# File `.env` TIDAK boleh di-commit (sudah ada di .gitignore). Yang di-commit hanya file contoh ini.
CODINX_BASE_URL=https://inttelix.vercel.app/api/v1
CODINX_API_KEY=isi_api_key_kamu_di_sini

# --- opsional (hapus tanda # untuk mengaktifkan) ---
# CODINX_MODEL=deepseek-v4-flash
# CODINX_TRIAL=1                 # 1 = masa uji coba: SEMUA model gratis (bawaan) | 0 = aturan paket FREE/PRO/MAX + Dinar
# CODINX_TIER=free                # free | pro | max (berlaku bila CODINX_TRIAL=0)
# CODINX_TOOL_MODE=auto           # auto | native | text | none   (auto = dideteksi lewat /doctor)
# CODINX_HISTORY_MODE=auto        # auto | native | flat          (flat = untuk gateway yang tidak meneruskan riwayat)
# CODINX_AUTO_PROBE=1             # diagnosa otomatis sekali per model
# CODINX_CONV_FIELD=              # nama field body untuk id percakapan, mis. conversation_id / chat_id
# CODINX_CONV_SOURCE=client       # client = id dibuat CodinX | server = pakai id dari server
